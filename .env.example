# Copy to .env and adjust. Loaded by the API server, drizzle-kit and Vite.

# Postgres connection string.
# Local (docker compose up -d db) — same credentials as the Replit DB:
DATABASE_URL=postgresql://postgres:password@localhost:5432/heliumdb?sslmode=disable
# On Replit the host is the internal "helium" hostname, which only resolves inside Replit:
# DATABASE_URL=postgresql://postgres:password@helium/heliumdb?sslmode=disable

# API server
API_PORT=8080
# Password for /admin. Checked only on the server, never shipped to the browser.
ADMIN_PASSWORD=change-me

# Web app (Vite dev server). /api requests are proxied to API_PORT.
WEB_PORT=5173
BASE_PATH=/

LOG_LEVEL=info
